{
  // No build step: the editor type-checks the plain JS through the JSDoc annotations.
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "es2023"]
  },
  "include": ["web/**/*.js"]
}
