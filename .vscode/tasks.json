{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "secret-sealer: start",
      "type": "shell",
      "command": "go run . -dev -open=false",
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": { "activeOnStart": true, "beginsPattern": "^", "endsPattern": "draait op" }
      }
    },
    {
      "label": "secret-sealer: test",
      "type": "shell",
      "command": "node --test \"test/*.test.js\" && go test ./...",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
