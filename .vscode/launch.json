{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Secret Sealer in Chrome",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "secret-sealer: start",
      "url": "http://localhost:8080/"
    },
    {
      "name": "Go-server debuggen",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "args": ["-dev", "-open=false"]
    }
  ]
}
